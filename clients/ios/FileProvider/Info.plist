<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>$(DISCODRIVE_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleSymbolName</key>
			<string>DDLogo</string>
		</dict>
	</dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>DiscoDriveAppGroup</key>
	<string>$(DISCODRIVE_APP_GROUP)</string>
	<key>DiscoDriveKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(DISCODRIVE_KEYCHAIN_GROUP)</string>
	<key>DiscoDriveURLScheme</key>
	<string>$(DISCODRIVE_URL_SCHEME)</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionFileProviderEnabledByDefault</key>
		<true/>
		<key>NSExtensionFileProviderSupportsEnumeration</key>
		<true/>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.fileprovider-nonui</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).FileProviderExtension</string>
	</dict>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 kosmosoid</string>
	<!-- ATS is off so a self-signed server reached by a DNS name can be used: ATS runs its own
	system-trust check and refuses the certificate the user trusted at pairing. DiscoKit's
	URLSession delegate still accepts only a system-trusted chain or that exact certificate
	fingerprint (DiscoNet), and http:// is refused in code except for loopback (URLPolicy).
	NSAllowsLocalNetworking must not be added back: when present, ATS ignores this key. -->
	<!-- Off so a server with a self-signed certificate can be used: the URLSession delegate still requires system trust or the certificate fingerprint the user confirmed at pairing, and URLPolicy.isAllowedServer refuses plain http (except localhost) before any request. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
