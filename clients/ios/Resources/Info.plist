<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>org.discodrive.ios.autoupload</string>
		<string>org.discodrive.ios.autoupload.refresh</string>
		<string>org.discodrive.ios.fullsync</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>DiscoDrive</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(DISCODRIVE_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>DiscoDriveAppGroup</key>
	<string>$(DISCODRIVE_APP_GROUP)</string>
	<key>DiscoDriveKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(DISCODRIVE_KEYCHAIN_GROUP)</string>
	<key>DiscoDriveURLScheme</key>
	<string>$(DISCODRIVE_URL_SCHEME)</string>
	<!-- Vaults use standard algorithms (AES, Cryptomator format) for the user's own data: the
	     mass-market exemption of EAR Category 5 Part 2 (740.17(b)(1)), so no export documentation
	     is uploaded and YES (which demands a compliance code from App Store Connect) is wrong.
	     The French declaration would still be needed for France, where the app is not sold. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- ATS is off so a self-signed server reached by a DNS name can be used: ATS runs its own
	system-trust check and refuses the certificate the user trusted at pairing. DiscoKit's
	URLSession delegate still accepts only a system-trusted chain or that exact certificate
	fingerprint (DiscoNet), and http:// is refused in code except for loopback (URLPolicy).
	NSAllowsLocalNetworking must not be added back: when present, ATS ignores this key. -->
	<!-- Off so a server with a self-signed certificate can be used: the URLSession delegate still requires system trust or the certificate fingerprint the user confirmed at pairing, and URLPolicy.isAllowedServer refuses plain http (except localhost) before any request. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSFaceIDUsageDescription</key>
	<string>Unlock the vault with Face ID</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>DiscoDrive uploads your photos and videos to your own server. Nothing is deleted from your phone.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
