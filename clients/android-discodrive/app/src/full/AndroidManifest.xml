<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- All Files Access: the sync folder lives at /sdcard/DiscoDriveSync so it stays visible
         in file managers and survives uninstall (a deliberate, user-facing synced folder,
         mirroring the desktop app), and auto-upload reads its source folders by path.
         Only this flavor, installed by hand from GitHub Releases, asks for it: Google Play
         restricts the permission, so the play flavor goes without it. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <!-- Open on an APK in the drive hands it to the system installer, which asks the user
         to allow installs from DiscoDrive first. Play restricts this permission too; the
         play flavor saves the APK to the device instead. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
</manifest>
