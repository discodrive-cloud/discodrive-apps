<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of this app is backed up or carried to a new phone: the pairing is encrypted
     with a Keystore key that never leaves the device (restoring it without the key made
     every launch crash), and the caches hold plaintext copies of cloud files. A new phone
     pairs again; the server is the source of truth. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
