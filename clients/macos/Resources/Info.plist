<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>DiscoDriveURLScheme</key><string>$(DISCODRIVE_URL_SCHEME)</string>
  <key>CFBundleDisplayName</key><string>$(DISCODRIVE_DISPLAY_NAME)</string>
  <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundleIconName</key><string>DiscoDrive</string>
  <!-- Identifier, executable and package type are mandatory when the plist is hand-written:
       without them the sandbox cannot create the app's container and the app dies at launch. -->
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
  <!-- discodrive://vault/open?id=… and …/close?id=… — what the Finder context menu sends. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key><string>org.discodrive.app</string>
      <key>CFBundleURLSchemes</key><array><string>$(DISCODRIVE_URL_SCHEME)</string></array>
    </dict>
  </array>
  <key>NSHumanReadableCopyright</key><string>© 2026 kosmosoid</string>
  <!-- Read at launch (DiscoDriveApp.init): the App Group and keychain access group shared
       with the File Provider extension. Must match DiscoDrive.entitlements. -->
  <key>DiscoDriveAppGroup</key><string>$(DEVELOPMENT_TEAM).$(DISCODRIVE_GROUP_SUFFIX)</string>
  <key>DiscoDriveKeychainGroup</key><string>$(DEVELOPMENT_TEAM).$(DISCODRIVE_GROUP_SUFFIX)</string>
</dict>
</plist>
