<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>DiscoDriveURLScheme</key><string>$(DISCODRIVE_URL_SCHEME)</string>
  <key>CFBundleDisplayName</key><string>$(DISCODRIVE_DISPLAY_NAME)</string>
  <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundlePackageType</key><string>XPC!</string>
  <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
  <key>NSHumanReadableCopyright</key><string>© 2026 kosmosoid</string>
  <!-- Same groups as the app (Resources/Info.plist): the index and the token are shared. -->
  <key>DiscoDriveAppGroup</key><string>$(DEVELOPMENT_TEAM).$(DISCODRIVE_GROUP_SUFFIX)</string>
  <key>DiscoDriveKeychainGroup</key><string>$(DEVELOPMENT_TEAM).$(DISCODRIVE_GROUP_SUFFIX)</string>
  <!-- The glyph Finder shows next to the domain in its sidebar, rendered as a template like
       the system's own locations: the DiscoDrive logo as a custom symbol from this
       extension's asset catalog. The app icon is not used there. -->
  <key>CFBundleIcons</key>
  <dict>
    <key>CFBundlePrimaryIcon</key>
    <dict><key>CFBundleSymbolName</key><string>DDLogo</string></dict>
  </dict>
  <key>NSExtension</key>
  <dict>
    <key>NSExtensionPointIdentifier</key><string>com.apple.fileprovider-nonui</string>
    <key>NSExtensionPrincipalClass</key><string>$(PRODUCT_MODULE_NAME).FileProviderExtension</string>
    <!-- Without SupportsEnumeration macOS reports "no launchable extension" (-2014) when
         the domain is added; without EnabledByDefault the domain starts user-disabled and
         nothing syncs until it is switched on in System Settings. -->
    <key>NSExtensionFileProviderSupportsEnumeration</key><true/>
    <!-- Context menu entries. The extension cannot show a window, so both hand the app a
         URL: it asks for the password, or drops the vault's domain. -->
    <key>NSExtensionFileProviderActions</key>
    <array>
      <dict>
        <key>NSExtensionFileProviderActionIdentifier</key><string>org.discodrive.openVault</string>
        <key>NSExtensionFileProviderActionName</key><string>Open vault</string>
        <key>NSExtensionFileProviderActionActivationRule</key>
        <string>fileproviderItems.@count == 1 AND SUBQUERY(fileproviderItems, $fileproviderItem, $fileproviderItem.userInfo.vault == 1).@count == 1</string>
      </dict>
      <dict>
        <key>NSExtensionFileProviderActionIdentifier</key><string>org.discodrive.closeVault</string>
        <key>NSExtensionFileProviderActionName</key><string>Close vault</string>
        <key>NSExtensionFileProviderActionActivationRule</key>
        <string>fileproviderItems.@count > 0 AND SUBQUERY(fileproviderItems, $fileproviderItem, $fileproviderItem.userInfo.vaultOpen == 1).@count == fileproviderItems.@count</string>
      </dict>
    </array>
    <key>NSExtensionFileProviderEnabledByDefault</key><true/>
  </dict>
</dict>
</plist>
